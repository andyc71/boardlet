# Uncomment the lines below you want to change by removing the # in the beginning

# App Store Connect requires Dynamic Island medium-size iPhone and 13-inch iPad screenshots.
# iPhone Duo uses its separate iOS 27.1 simulator in the screenshots lane.
# https://developer.apple.com/help/app-store-connect/reference/app-information/screenshot-specifications/
duo_capture = ENV["BOARDLET_SNAPSHOT_DEVICE_GROUP"] == "duo"
devices(duo_capture ? ["iPhone Duo"] : ["iPhone 18 Pro", "iPad Pro 13-inch (M5)"])

ios_version(duo_capture ? '27.1' : '27.0')

# xcodebuild strips TEST_RUNNER_ before passing this to the screenshot UI tests.
ENV["TEST_RUNNER_BOARDLET_TEST_ORIENTATION"] ||= "portrait"

languages([
   "en-US",
   "es-ES"
#   "de-DE",
#   "it-IT",
#   ["pt", "pt_BR"] # Portuguese with Brazilian locale
])

# The name of the scheme which contains the UI Tests
scheme("PECS Maker UI Tests Screenshots")

# Where should the resulting screenshots be stored?
# output_directory("./screenshots")

# remove the '#' to clear all previously generated screenshots before creating new ones
clear_previous_screenshots(true)

# Remove the '#' to set the status bar to 9:41 AM, and show full battery and reception. See also override_status_bar_arguments for custom options.
override_status_bar(true)

# Arguments to pass to the app on launch. See https://docs.fastlane.tools/actions/snapshot/#launch-arguments
# launch_arguments(["-favColor red"])

# For more information about all available options run
# fastlane action snapshot

#dark_mode(false)

headless(ENV["BOARDLET_SNAPSHOT_HEADLESS"] == "1")

stop_after_first_error(true)

number_of_retries(0)

clean(false)

concurrent_simulators(false)

result_bundle(true)

output_directory("screenshots/")

#test_without_building(true)

#derived_data_path("./fastlane/DerivedData")

